<?xml version='1.0' encoding='utf-8'?>
<widget id="com.lionel.ai" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <name>Lionel AI</name>
    <description>Assistente Proativo e Evolutivo 2026</description>
    <author email="dev@lionel.ai">Lionel Dev</author>

    <content src="index.html" />
    <access origin="*" />

    <preference name="AndroidXEnabled" value="true" />
    <preference name="KeepRunning" value="true" />
    <preference name="MediaPlaybackRequiresUserAction" value="false" />

    <platform name="android">
        <config-file target="AndroidManifest.xml" parent="/*">
            <!-- Permissões necessárias -->
            <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"/>
            <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
            <uses-permission android:name="android.permission.RECORD_AUDIO"/>
            <uses-permission android:name="android.permission.CAMERA"/>
            <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
            <uses-permission android:name="android.permission.BLUETOOTH_SCAN"/>
            <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
            <uses-permission android:name="android.permission.INTERNET"/>
            <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
            <uses-permission android:name="android.permission.WAKE_LOCK"/>
            <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
            <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
            <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
        </config-file>
    </platform>

    <!-- Plugins -->
    <plugin name="cordova-plugin-camera" spec="^7.0.0" />
    <plugin name="cordova-plugin-media" spec="^7.0.0" />
    <plugin name="cordova-plugin-file" spec="^8.0.0" />
    <plugin name="cordova-plugin-background-mode" spec="^0.7.3" />
    <plugin name="cordova-plugin-device" spec="^3.0.0" />
    <plugin name="cordova-plugin-android-permissions" spec="^1.1.5" />
    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />
</widget>
